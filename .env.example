DATABASE_URL="file:../dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Optional: used by POST /api/list to draft title/description/category/price from the photo.
# Prefer a free OpenRouter key (https://openrouter.ai/keys) — no OpenAI/Claude needed.
# If none of these are set, the sell form still prefills a generic draft you can edit.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
